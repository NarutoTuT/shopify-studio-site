# Resend email delivery for /api/contact
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL_TO=

# Google Search Console API (OAuth 2.0, read-only)
# Use the exact property identifier shown in Search Console.
GSC_SITE_URL=https://whaleleap.studio/
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
# Comma-separated, case-insensitive phrases used to classify branded queries.
GSC_BRAND_TERMS=whaleleap,whale leap,whaleleap studio
# Maximum exported rows per dimension. Search Console returns top rows only.
GSC_MAX_ROWS=100000

# Google Analytics measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=
